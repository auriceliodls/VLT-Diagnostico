# Server-only secret; never prefix this with VITE_.
GEMINI_API_KEY="your-server-side-gemini-api-key"

# Firebase project used to validate Firebase ID tokens.
FIREBASE_PROJECT_ID="your-firebase-project-id"

# Comma-separated server-side access control lists.
AUTHORIZED_EMAILS="technician@example.com"
ADMIN_EMAILS="admin@example.com"

# APP_URL: Optional URL where this applet is hosted.
APP_URL="https://your-app.example.com"
